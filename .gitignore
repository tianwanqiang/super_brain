# Python
__pycache__/
*.pyc

# 真实凭据（微信 appid/key、默认封面图等），不能进公开仓库
config.json

# dispatcher.py 运行时生成的建议草稿，不需要进版本控制
dispatch_log/

# 运行日志
logs/

# 圆桌讨论原始记录（question/round1/round2 的 JSON 落地）——老的扁平存储，
# 已经被 conversations/ 取代，只留着做一次性迁移，不需要进版本控制
roundtable_log/

# 会话数据（真实讨论历史，含追问上下文），是个人数据不是代码
conversations/

# 专家自我反思积累（运行时产物，供以后定期复盘参考，不是代码）
agents/*/lessons.md

# 会议纪要转草稿的执行记录（同样是运行时产物，供 UI 展示"已生成过草稿"用）
draft_log/

# video-prompt 的多轮对话记录，是个人数据不是代码
video_prompt_conversations/

# 专家私聊记录（隔离会话，含真实追问内容），是个人数据不是代码
private_chat_conversations/

# 每日 18 点批量汇总（含当天真实任务/讨论摘要），是个人数据不是代码
daily_digests/

# Round 3 收敛出的任务条目（含真实决策描述），是个人数据不是代码
tasks.yaml

# Round 3 任务确认后生成的产物草稿，是运行时产物不是代码
task_drafts/

# 机制 2 定期复盘生成的建议（源头是 lessons.md，同样是运行时产物不是代码）
agents/*/reviews/

# RAG 检索索引——从 private.md 派生出来的构建产物（切块+向量），不是权威数据源，
# private.md 变了会自动重建，不需要进版本控制（而且向量文件是二进制，不适合 git diff）
agents/*/rag_chunks.json
agents/*/rag_index.npy
